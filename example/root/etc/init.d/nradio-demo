#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled interval
	config_load nradio_demo
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get interval main interval 300
	case "$interval" in ''|*[!0-9]*) interval=300 ;; esac
	[ "$interval" -ge 60 ] && [ "$interval" -le 3600 ] || interval=300
	procd_open_instance
	procd_set_param command /bin/sh /usr/libexec/nradio-demo/worker.sh "$interval"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/nradio_demo
	procd_close_instance
}

stop_service() {
	rm -f /tmp/nradio-demo/status /tmp/nradio-demo/status.new
	rmdir /tmp/nradio-demo 2>/dev/null || true
}

service_triggers() {
	procd_add_reload_trigger nradio_demo
}

reload_service() {
	stop
	start
}
